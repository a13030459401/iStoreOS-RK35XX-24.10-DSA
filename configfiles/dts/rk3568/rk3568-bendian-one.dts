// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * Device Tree for BenDian One (RK3568) - Mainline Linux 6.x Edition
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pwm/pwm.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include <dt-bindings/soc/rockchip,vop2.h>
#include <dt-bindings/thermal/thermal.h>
#include <dt-bindings/phy/phy.h>
#include "rk3568.dtsi"
#include "rk3568-vngpu.dtsi"
#include "rk3568-ramoops.dtsi"

/ {
    model = "BenDian One";
    compatible = "bendian,bd-one", "rockchip,rk3568";

    /* 正确的网卡主次：独立千兆为 WAN (ethernet0)，4口交换机为 LAN (ethernet1) */
    aliases {
        ethernet0 = &gmac0;
        ethernet1 = &gmac1;
        mmc0 = &sdhci;
        serial2 = &uart2;
    };

    chosen {
        stdout-path = "serial2:1500000n8";
    };

    reserved-memory {
        #address-cells = <2>;
        #size-cells = <2>;
        ranges;

        linux,cma {
            compatible = "shared-dma-pool";
            reusable;
            size = <0x0 0x10000000>; /* 256MB */
            linux,cma-default;
        };
    };

    /* 状态指示灯 */
    gpio-leds {
        compatible = "gpio-leds";
        pinctrl-names = "default";
        pinctrl-0 = <&power_led_pin &status_led_pin>;

        led_power: led-0 {
            label = "red:power";
            gpios = <&gpio4 RK_PB3 GPIO_ACTIVE_LOW>;
            default-state = "on";
        };

        led-1 {
            label = "green:status";
            gpios = <&gpio4 RK_PB1 GPIO_ACTIVE_LOW>;
            linux,default-trigger = "heartbeat";
        };
    };

    /* 温控风扇 */
    fan: gpio-fan {
        compatible = "gpio-fan";
        pinctrl-names = "default";
        pinctrl-0 = <&fan_pins>;
        gpios = <&gpio4 RK_PA7 GPIO_ACTIVE_HIGH>;
        gpio-fan,speed-map = <0 0>, <7500 1>;
        #cooling-cells = <2>;
        cooling-min-level = <0>;
        cooling-max-level = <1>;
        status = "okay";
    };

    hdmi_con: hdmi-con {
        compatible = "hdmi-connector";
        type = "a";
	status = "okay";

        port {
            hdmi_con_in: endpoint {
                remote-endpoint = <&hdmi_out_con>;
            };
        };
    };

    hdmi-sound {
        compatible = "simple-audio-card";
        simple-audio-card,name = "HDMI";
        simple-audio-card,format = "i2s";
        simple-audio-card,mclk-fs = <256>;
        status = "okay";

        simple-audio-card,codec {
            sound-dai = <&hdmi>;
        };

        simple-audio-card,cpu {
            sound-dai = <&i2s0_8ch>;
        };
    };

    adc-keys {
        compatible = "adc-keys";
        io-channels = <&saradc 0>;
        io-channel-names = "buttons";
        keyup-threshold-microvolt = <1800000>;
        poll-interval = <100>;

        button-recovery {
            label = "Recovery";
            linux,code = <KEY_VENDOR>;
            press-threshold-microvolt = <1750>;
        };
    };

    /* 电源架构总线 */
    vcc12v_dcin: vcc12v-dcin {
        compatible = "regulator-fixed";
        regulator-name = "vcc12v_dcin";
        regulator-always-on;
        regulator-boot-on;
        regulator-min-microvolt = <12000000>;
        regulator-max-microvolt = <12000000>;
    };

    vcc3v3_sys: vcc3v3-sys {
        compatible = "regulator-fixed";
        regulator-name = "vcc3v3_sys";
        regulator-always-on;
        regulator-boot-on;
        regulator-min-microvolt = <3300000>;
        regulator-max-microvolt = <3300000>;
        vin-supply = <&vcc12v_dcin>;
    };

    vcc5v0_sys: vcc5v0-sys {
        compatible = "regulator-fixed";
        regulator-name = "vcc5v0_sys";
        regulator-always-on;
        regulator-boot-on;
        regulator-min-microvolt = <5000000>;
        regulator-max-microvolt = <5000000>;
        vin-supply = <&vcc12v_dcin>;
    };

vcc5v0_usb: vcc5v0-usb {
    compatible = "regulator-fixed";
    regulator-name = "vcc5v0_usb";
    enable-active-high;
    gpio = <&gpio0 RK_PC1 GPIO_ACTIVE_HIGH>;
    pinctrl-names = "default";
    pinctrl-0 = <&usb_pwr_en>;

    regulator-boot-on;
    regulator-always-on;

    regulator-min-microvolt = <5000000>;
    regulator-max-microvolt = <5000000>;
    vin-supply = <&vcc5v0_sys>;
    startup-delay-us = <1000000>;

    regulator-state-mem {
        regulator-off-in-suspend;
    };
};

    vcc_3v3: vcc-3v3 {
        compatible = "regulator-fixed";
        regulator-name = "vcc_3v3";
        regulator-always-on;
        regulator-boot-on;
        regulator-min-microvolt = <3300000>;
        regulator-max-microvolt = <3300000>;
        vin-supply = <&vcc3v3_sys>;
    };

    vcc_1v8: vcc-1v8 {
        compatible = "regulator-fixed";
        regulator-name = "vcc_1v8";
        regulator-always-on;
        regulator-boot-on;
        regulator-min-microvolt = <1800000>;
        regulator-max-microvolt = <1800000>;
        vin-supply = <&vcc3v3_sys>;
    };

    vcca_1v8: vcca-1v8 {
        compatible = "regulator-fixed";
        regulator-name = "vcca_1v8";
        regulator-always-on;
        regulator-boot-on;
        regulator-min-microvolt = <1800000>;
        regulator-max-microvolt = <1800000>;
        vin-supply = <&vcc3v3_sys>;
    };

    vdda_0v9: vdda-0v9 {
        compatible = "regulator-fixed";
        regulator-name = "vdda_0v9";
        regulator-always-on;
        regulator-boot-on;
        regulator-min-microvolt = <900000>;
        regulator-max-microvolt = <900000>;
        vin-supply = <&vcc3v3_sys>;
    };

    /* NVMe SSD 独立供电链 */
    vcc3v3_pi6c_03: vcc3v3-pi6c-03 {
        compatible = "regulator-fixed";
        regulator-name = "vcc3v3_pi6c_03";
        enable-active-high;
        gpio = <&gpio0 RK_PC0 GPIO_ACTIVE_HIGH>;
        pinctrl-names = "default";
        pinctrl-0 = <&ssd_pwr_en>;
        regulator-min-microvolt = <3300000>;
        regulator-max-microvolt = <3300000>;
        vin-supply = <&vcc12v_dcin>;
        startup-delay-us = <200000>;
    };

    vcc3v3_pcie: vcc3v3-pcie {
        compatible = "regulator-fixed";
        regulator-name = "vcc3v3_pcie";
        regulator-always-on;
        regulator-boot-on;
        regulator-min-microvolt = <3300000>;
        regulator-max-microvolt = <3300000>;
        vin-supply = <&vcc3v3_pi6c_03>;
    };

    /* 真实硬件：PWM4 调压 GPU */
    vdd_gpu: vdd-gpu {
        compatible = "pwm-regulator";
        pwms = <&pwm4 0 5000 1>;
        pwm-supply = <&vcc3v3_sys>;
        regulator-name = "vdd_gpu";
        regulator-always-on;
        regulator-boot-on;
        regulator-init-microvolt = <900000>;
        regulator-min-microvolt = <500000>;
        regulator-max-microvolt = <1350000>;
        regulator-ramp-delay = <6001>;
        regulator-settling-time-up-us = <250>;
    };

    /* 真实硬件：PWM5 调压 Logic */
    vdd_logic: vdd-logic {
        compatible = "pwm-regulator";
        pwms = <&pwm5 0 5000 1>;
        pwm-supply = <&vcc3v3_sys>;
        regulator-name = "vdd_logic";
        regulator-always-on;
        regulator-boot-on;
        regulator-init-microvolt = <900000>;
        regulator-min-microvolt = <500000>;
        regulator-max-microvolt = <1350000>;
        regulator-ramp-delay = <6001>;
        regulator-settling-time-up-us = <250>;
    };
};

/* 开启用于调压的硬件 PWM4 & PWM5 */
&pwm4 { status = "okay"; };
&pwm5 { status = "okay"; };

/* 彻底禁用占用了 WAN 口引脚的 UART3，以及不存在的 I2C5/UART5 */
&uart3 { status = "disabled"; };
&uart5 { status = "disabled"; };
&i2c5 {
    /delete-property/ pinctrl-names;
    /delete-property/ pinctrl-0;
    status = "disabled";
};
&uart2 { status = "okay"; };

/* CPU 电源管理：板载真实 TCS4525 */
&i2c0 {
    status = "okay";

    vdd_cpu: regulator@1c {
        compatible = "tcs,tcs4525";
        reg = <0x1c>;
        fcs,suspend-voltage-selector = <1>;
        regulator-name = "vdd_cpu";
        regulator-always-on;
        regulator-boot-on;
        regulator-init-microvolt = <900000>;
        regulator-min-microvolt = <712500>;
        regulator-max-microvolt = <1390000>;
        regulator-ramp-delay = <2300>;
        vin-supply = <&vcc5v0_sys>;

        regulator-state-mem {
            regulator-off-in-suspend;
        };
    };
};

&cpu0 { cpu-supply = <&vdd_cpu>; };
&cpu1 { cpu-supply = <&vdd_cpu>; };
&cpu2 { cpu-supply = <&vdd_cpu>; };
&cpu3 { cpu-supply = <&vdd_cpu>; };

/* GPU：挂载 PWM4 调压轨，支持主线内核 Panfrost 驱动 */
&gpu {
    mali-supply = <&vdd_gpu>;
    status = "okay";
};

/* Combo PHY */
&combphy0 { status = "okay"; };
&combphy1 { status = "okay"; };
&combphy2 { status = "okay"; };

/* 双原生 SATA */
&sata0 {
    status = "okay";
    ahci-supply = <&vcc3v3_sys>;
    phy-supply = <&vcc3v3_sys>;
    target-supply = <&vcc3v3_sys>;
    phys = <&combphy1 PHY_TYPE_SATA>;
    phy-names = "sata-phy";
};

&sata1 {
    status = "okay";
    ahci-supply = <&vcc3v3_sys>;
    phy-supply = <&vcc3v3_sys>;
    target-supply = <&vcc3v3_sys>;
    phys = <&combphy0 PHY_TYPE_SATA>;
    phy-names = "sata-phy";
};

/* eMMC */
&sdhci {
    bus-width = <8>;
    max-frequency = <200000000>;
    non-removable;
    mmc-hs200-1_8v;
    pinctrl-names = "default";
    pinctrl-0 = <&emmc_bus8 &emmc_clk &emmc_cmd>;
    status = "okay";
};

/* USB 控制器 */
&usb2phy0 { status = "okay"; };
&usb2phy0_host {
    phy-supply = <&vcc5v0_usb>;
    status = "okay";
};
&usb2phy0_otg {
    phy-supply = <&vcc5v0_usb>;
    status = "okay";
};

&usb_host0_xhci {
    dr_mode = "host";
    phys = <&usb2phy0_otg>, <&usb2phy0_host>;
    phy-names = "usb2-phy", "usb2-phy";
    extcon = <&usb2phy0>;
    maximum-speed = "high-speed";
    snps,dis_u2_susphy_quirk;
    status = "okay";
};

&usb_host0_ehci { status = "disabled"; };
&usb_host0_ohci { status = "disabled"; };
&usb2phy1 { status = "disabled"; };

/* PCIe */
&pcie2x1 {
    reset-gpios = <&gpio3 RK_PC1 GPIO_ACTIVE_HIGH>;
    vpcie3v3-supply = <&vcc3v3_sys>;
    pinctrl-names = "default";
    pinctrl-0 = <&pcie20_reset_pin>;
    status = "okay";
};

&pcie30phy { status = "okay"; };
&pcie3x2 {
    reset-gpios = <&gpio0 RK_PC6 GPIO_ACTIVE_HIGH>;
    vpcie3v3-supply = <&vcc3v3_pcie>;
    pinctrl-names = "default";
    pinctrl-0 = <&pcie30_reset_pin>;
    rockchip,perst-inactive-ms = <500>;
/* 暂不使用旧 BSP 的 PCIe ranges，先测试 Linux 6.x 默认窗口映射。 */
/*
ranges = <0x01000000 0x00 0xf0100000 0x00 0xf0100000 0x00 0x00100000>,
         <0x02000000 0x00 0xf0200000 0x00 0xf0200000 0x00 0x01e00000>,
         <0x03000000 0x00 0x40000000 0x03 0x80000000 0x00 0x40000000>;
*/
    status = "okay";
};

/* GMAC0: 4口交换机 (LAN1~LAN4) */
&gmac0 {
    assigned-clocks = <&cru SCLK_GMAC0_RX_TX>, <&cru SCLK_GMAC0>;
    assigned-clock-parents = <&cru SCLK_GMAC0_RGMII_SPEED>, <&cru CLK_MAC0_2TOP>;
    assigned-clock-rates = <0>, <125000000>;
    clock_in_out = "output";
    phy-mode = "rgmii-id";
    pinctrl-names = "default";
    pinctrl-0 = <&gmac0_miim &gmac0_tx_bus2 &gmac0_rx_bus2 &gmac0_rgmii_clk &gmac0_rgmii_bus>;
    tx_delay = <0x3c>;
    rx_delay = <0x2f>;
    status = "okay";

    fixed-link {
        speed = <1000>;
        full-duplex;
    };
};

&mdio0 {
    compatible = "snps,dwmac-mdio";
    #address-cells = <1>;
    #size-cells = <0>;

    rtl8367s: switch@1d {
        compatible = "realtek,rtl8365mb";
        reg = <0x1d>;
        reset-gpios = <&gpio0 RK_PA5 GPIO_ACTIVE_LOW>;
        reset-assert-us = <50000>;
        reset-deassert-us = <200000>;
        pinctrl-names = "default";
        pinctrl-0 = <&gmac0_reset>;

        switch_intc: interrupt-controller {
            #address-cells = <0>;
            #interrupt-cells = <1>;
            interrupt-controller;
        };

        mdio {
            compatible = "realtek,smi-mdio";
            #address-cells = <1>;
            #size-cells = <0>;

            phy0: ethernet-phy@0 { reg = <0>; };
            phy1: ethernet-phy@1 { reg = <1>; };
            phy2: ethernet-phy@2 { reg = <2>; };
            phy3: ethernet-phy@3 { reg = <3>; };
        };

        ports {
            #address-cells = <1>;
            #size-cells = <0>;

            port@0 {
                reg = <0>;
                label = "lan4";
                phy-mode = "internal";
                phy-handle = <&phy0>;
            };

            port@1 {
                reg = <1>;
                label = "lan3";
                phy-mode = "internal";
                phy-handle = <&phy1>;
            };

            port@2 {
                reg = <2>;
                label = "lan2";
                phy-mode = "internal";
                phy-handle = <&phy2>;
            };

            port@3 {
                reg = <3>;
                label = "lan1";
                phy-mode = "internal";
                phy-handle = <&phy3>;
            };

            port@7 {
                reg = <7>;
                label = "cpu";
                ethernet = <&gmac0>;
                phy-mode = "rgmii-id";

                fixed-link {
                    speed = <1000>;
                    full-duplex;
                };
            };
        };
    };
};

/* GMAC1: 独立千兆 WAN 口 (解除引脚冲突) */
&gmac1 {
    assigned-clocks = <&cru SCLK_GMAC1_RX_TX>, <&cru SCLK_GMAC1>;
    assigned-clock-parents = <&cru SCLK_GMAC1_RGMII_SPEED>;
    assigned-clock-rates = <0>, <125000000>;
    clock_in_out = "output";
    phy-mode = "rgmii";
    phy-handle = <&rgmii_phy1>;
    pinctrl-names = "default";
    pinctrl-0 = <&gmac1m0_miim &gmac1m0_tx_bus2 &gmac1m0_rx_bus2 &gmac1m0_rgmii_clk &gmac1m0_rgmii_bus>;
    snps,reset-gpio = <&gpio1 RK_PB1 GPIO_ACTIVE_LOW>;
    snps,reset-active-low;
    snps,reset-delays-us = <0 20000 100000>;
    tx_delay = <0x30>;
    rx_delay = <0x10>;
    status = "okay";
};

&mdio1 {
    rgmii_phy1: ethernet-phy@0 {
        compatible = "ethernet-phy-ieee802.3-c22";
        reg = <0>;
        realtek,led-data = <0x17b>;
    };
};

/* CPU 温控 */
&cpu_thermal {


    polling-delay = <1000>;
    polling-delay-passive = <250>;

    /delete-node/ trips;
    /delete-node/ cooling-maps;

    trips {
        /* 65°C 开全速；温度低于 60°C 才停止 */
        cpu_fan_on: cpu-fan-on {
            temperature = <65000>;
            hysteresis = <5000>;
            type = "active";
        };

        /* 75°C 开始温和限频 */
        cpu_alert0: cpu-alert0 {
            temperature = <75000>;
            hysteresis = <5000>;
            type = "passive";
        };

        /* 85°C 明显限频 */
        cpu_alert1: cpu-alert1 {
            temperature = <85000>;
            hysteresis = <2000>;
            type = "passive";
        };

        /* 95°C 热保护 */
        cpu_crit: cpu-crit {
            temperature = <95000>;
            hysteresis = <2000>;
            type = "critical";
        };
    };

    cooling-maps {
        map_fan {
            trip = <&cpu_fan_on>;
            cooling-device = <&fan 1 1>;
        };

        map_cpu_mild {
            trip = <&cpu_alert0>;
            cooling-device =
                <&cpu0 THERMAL_NO_LIMIT 2>,
                <&cpu1 THERMAL_NO_LIMIT 2>,
                <&cpu2 THERMAL_NO_LIMIT 2>,
                <&cpu3 THERMAL_NO_LIMIT 2>;
        };

        map_cpu_heavy {
            trip = <&cpu_alert1>;
            cooling-device =
                <&cpu0 2 THERMAL_NO_LIMIT>,
                <&cpu1 2 THERMAL_NO_LIMIT>,
                <&cpu2 2 THERMAL_NO_LIMIT>,
                <&cpu3 2 THERMAL_NO_LIMIT>;
        };
    };
};

/* GPU 温控：先开风扇，再限制 GPU */
&gpu_thermal {

    polling-delay = <1000>;
    polling-delay-passive = <250>;

    /delete-node/ trips;
    /delete-node/ cooling-maps;

    trips {
        /* GPU 达 65°C：风扇全速；低于 60°C 才关闭 */
        gpu_fan_on: gpu-fan-on {
            temperature = <65000>;
            hysteresis = <5000>;
            type = "active";
        };

        /* GPU 达 75°C：开始限制 GPU OPP */
        gpu_alert: gpu-alert {
            temperature = <75000>;
            hysteresis = <2000>;
            type = "passive";
        };

        /* GPU 达 95°C：保护动作 */
        gpu_crit: gpu-crit {
            temperature = <95000>;
            hysteresis = <2000>;
            type = "critical";
        };
    };

    cooling-maps {
        map_fan {
            trip = <&gpu_fan_on>;
            cooling-device = <&fan 1 1>;
        };

        map_gpu {
            trip = <&gpu_alert>;
            cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
        };
    };
};

&hdmi {
    status = "okay";
    #sound-dai-cells = <0>;

    avdd-0v9-supply = <&vdda_0v9>;
    avdd-1v8-supply = <&vcca_1v8>;

    pinctrl-names = "default";
    pinctrl-0 = <&hdmitx_scl>,
                <&hdmitx_sda>,
                <&hdmitxm0_cec>;

    rockchip,phy-table =
        <92812500  0x8009 0x0000 0x0270>,
        <165000000 0x800b 0x0000 0x026d>,
        <185625000 0x800b 0x0000 0x01ed>,
        <297000000 0x8019 0x0000 0x01ad>,
        <594000000 0x8039 0x0000 0x019d>;
};

&vop {
    assigned-clocks = <&cru DCLK_VOP0>, <&cru DCLK_VOP1>;
    assigned-clock-parents = <&pmucru PLL_HPLL>, <&cru PLL_VPLL>;
    status = "okay";
};

&hdmi_in {
    hdmi_in_vp0: endpoint {
        remote-endpoint = <&vp0_out_hdmi>;
    };
};

&hdmi_out {
    hdmi_out_con: endpoint {
        remote-endpoint = <&hdmi_con_in>;
    };
};

&vp0 {
    vp0_out_hdmi: endpoint {
        remote-endpoint = <&hdmi_in_vp0>;
    };
};

&vop_mmu {
    status = "okay";
};

&i2s0_8ch { status = "okay"; };
&saradc {
    vref-supply = <&vcca_1v8>;
    status = "okay";
};

&tsadc {
    rockchip,hw-tshut-mode = <1>;
    rockchip,hw-tshut-polarity = <0>;
    status = "okay";
};

&pmu_io_domains {
    pmuio1-supply = <&vcc_3v3>;
    pmuio2-supply = <&vcc_3v3>;
    vccio1-supply = <&vcc_3v3>;
    vccio2-supply = <&vcc_1v8>;
    vccio3-supply = <&vcc_3v3>;
    vccio4-supply = <&vcc_1v8>;
    vccio5-supply = <&vcc_3v3>;
    vccio6-supply = <&vcc_1v8>;
    vccio7-supply = <&vcc_3v3>;
    status = "okay";
};

&pinctrl {
    fan {
        fan_pins: fan-pins {
            rockchip,pins = <4 RK_PA7 RK_FUNC_GPIO &pcfg_pull_none>;
        };
    };

    gpio-leds {
        power_led_pin: power-led-pin {
            rockchip,pins = <4 RK_PB3 RK_FUNC_GPIO &pcfg_pull_none>;
        };

        status_led_pin: status-led-pin {
            rockchip,pins = <4 RK_PB1 RK_FUNC_GPIO &pcfg_pull_none>;
        };
    };

pcie {
    /* M.2/NVMe 3.3 V 供电使能：GPIO0_C0 */
    ssd_pwr_en: ssd-pwr-en {
        rockchip,pins = <0 RK_PC0 RK_FUNC_GPIO &pcfg_pull_none>;
    };

    /* M.2/NVMe 的 PERST#：GPIO0_C6 */
    pcie30_reset_pin: pcie30-reset-pin {
        rockchip,pins = <0 RK_PC6 RK_FUNC_GPIO &pcfg_pull_none>;
    };

    /* PCIe 2.0 x1 的 reset：GPIO3_C1 */
    pcie20_reset_pin: pcie20-reset-pin {
        rockchip,pins = <3 RK_PC1 RK_FUNC_GPIO &pcfg_pull_none>;
    };
};

    usb {
        usb_pwr_en: usb-pwr-en {
            rockchip,pins = <0 RK_PC1 RK_FUNC_GPIO &pcfg_pull_down>;
        };
    };

    gmac-reset {
        gmac0_reset: gmac0-reset {
            /* rockchip,pins = <0 RK_PA5 RK_FUNC_GPIO &pcfg_pull_none>;优化：将 pinctrl 改为弱上拉 &pcfg_pull_up，防止交换机开机偶发丢包或识别不到：*/

	    rockchip,pins = <0 RK_PA5 RK_FUNC_GPIO &pcfg_pull_up>;
        };
    };
};  /* 这一行必须存在，关闭 &pinctrl */

/* Mali-G52 GPU */
&gpu {
    mali-supply = <&vdd_gpu>;
    operating-points-v2 = <&gpu_opp_table>;
    power-off-delay-ms = <20>;
    status = "okay";
};

/* RKNPU 神经网络加速及动态调频 */
&{/npu@fde40000} {
    rknpu-supply = <&vdd_logic>;
    operating-points-v2 = <&npu_opp_table>;
    status = "okay";
};

&rknpu_mmu {
    status = "okay";
};

&bus_npu {
    bus-supply = <&vdd_logic>;
    operating-points-v2 = <&bus_npu_opp_table>;
    status = "okay";
};

/* VPU 视频硬件解码动态调频 */
&rkvdec {
    vdec-supply = <&vdd_logic>;
    operating-points-v2 = <&rkvdec_opp_table>;
    status = "okay";
};
